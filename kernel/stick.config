CONFIG_MMU=y
CONFIG_ARCH_MULTIPLATFORM=y
CONFIG_ARCH_MULTI_V7=y
CONFIG_ARCH_ROCKCHIP=y
CONFIG_SMP=y
CONFIG_NR_CPUS=2
CONFIG_HAVE_ARM_ARCH_TIMER=n
CONFIG_HAVE_ARM_TWD=y
