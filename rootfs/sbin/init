#!/bin/sh
# StickOS startup (pid 1). The SD data partition is already mounted on /sd.
export PATH=/bin:/usr/bin LD_LIBRARY_PATH=/usr/lib/arm-linux-gnueabihf HOME=/tmp
mount -t proc proc /proc
mount -t sysfs sysfs /sys
if ! mount -t devtmpfs devtmpfs /dev; then
    mount -t tmpfs tmpfs /dev
    mdev -s
fi
mkdir -p /dev/pts
mount -t devpts devpts /dev/pts
mount -t tmpfs tmpfs /tmp
for g in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
    echo performance > "$g"
done 2>/dev/null
D=/sd/stickos/logs
mkdir -p $D
# logs written by older versions directly in stickos/
mv -n /sd/stickos/*.log $D/ 2>/dev/null
L=$D/init.log
echo "StickOS: started $(date), kernel $(uname -r)" > $L
# New kernel, if present on the SD: started from the stock kernel without touching the flash.
# The file "try" lists the device trees to try (empty = stick.dtb), one for each start: the
# line is removed before jumping, so after the last one the stock kernel is used again.
# "always" = stick.dtb at every start (once it works).
K=/sd/stickos/kernel
case $(uname -r) in 3.0.36*)
    if [ -f $K/tried ]; then            # log left in RAM by the last attempt
        kjump -d $D/ramoops.bin > $D/kjump-ram.log 2>&1
        T=$(cat $K/tried)
        [ -f $K/reached ] && rm -f $K/try $K/reached    # it reached StickOS: no need for the others
        for f in kjump initrd new dmesg-new clk-new drm-state; do
            [ -f $D/$f.log ] && mv $D/$f.log $D/$f-${T%.dtb}.log
        done
        mv $K/tried $K/done
        sync
    fi
    T=
    if [ -f $K/try ]; then
        T=$(head -n 1 $K/try)
        R=$(sed 1d $K/try)
        rm $K/try
        sync
        [ -n "$R" ] && echo "$R" > $K/try
        T=${T:-stick.dtb}
        rm -f $K/reached
        echo "$T" > $K/tried
        sync
    elif [ -f $K/always ]; then
        T=stick.dtb
    fi
    if [ -n "$T" ] && [ -f $K/zImage ] && [ -f $K/$T ] && [ -f $K/initrd ]; then
        dmesg > $D/dmesg-stock.log
        kjump $([ -f $K/watchdog ] && echo -w) $K/zImage $K/$T $K/initrd > $D/kjump.log 2>&1
        echo "kjump exited with code $?" >> $L      # only if it failed
        sync
    fi ;;
*)
    : > $K/reached                                  # for the stock kernel: this start worked
    dmesg > $D/dmesg-new.log; sync                  # early copy, in case something hangs later
    [ -f $K/debug ] && [ -f $K/new.sh ] && sh $K/new.sh ;;    # diagnostics
esac
(sleep 15; dmesg > $D/dmesg.log; sync) &
while :; do
    /usr/bin/stickui
    echo "stickui exited with code $?" >> $L
    sync
    sleep 2
done
